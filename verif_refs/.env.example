# Copiez ce fichier en « .env » (dans le même dossier) et complétez-le.
# Ne publiez jamais le fichier .env : il contient votre clé.

# Clé Gemini, gratuite sur https://aistudio.google.com/app/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=

# Votre adresse, transmise à Crossref et OpenAlex (règle d'usage)
VERIF_REFS_CONTACT=

# Facultatif : autre modèle Gemini
# VERIF_REFS_MODELE=gemini-flash-lite-latest
